{
    # Keep certificate automation for the HTTPS origin, but do not redirect the
    # HTTP origin connection used by Cloudflare Flexible mode.
    auto_https disable_redirects
}

(team_app) {
    encode zstd gzip

    handle_path /media/* {
        root * /srv/media
        file_server
        header Cache-Control "public, max-age=3600"
    }

    handle {
        reverse_proxy web:8000
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    log {
        output stdout
        format console
    }
}

http://team.smarbiz.sbs {
    import team_app
}

https://team.smarbiz.sbs {
    import team_app
}
